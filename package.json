{
  "private": true,
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "pnpm": "9.15.4"
  },
  "scripts": {
    "preinstall": "node scripts/check-pnpm-version.mjs",
    "test:branding": "node --test scripts/branding.test.mjs",
    "create:app": "pnpm --filter @healseek/create-app build && node internal/create-app/dist/index.js",
    "build": "turbo run build",
    "dev": "node scripts/dev.mjs",
    "dev:all": "node scripts/dev.mjs --all",
    "dev:demo": "node scripts/dev.mjs playwright --mock",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "verify:sidebar": "node scripts/verify-sidebar-matrix.mjs",
    "verify:primitives": "node scripts/verify-command-combobox-calendar.mjs",
    "verify:datatable": "node scripts/verify-datatable-matrix.mjs",
    "verify:sectionpage": "node scripts/verify-sectionpage-matrix.mjs",
    "verify:overlays": "node scripts/verify-overlay-matrix.mjs",
    "verify:json-form": "node scripts/verify-json-form-matrix.mjs"
  },
  "devDependencies": {
    "anymatch": "^3.1.3",
    "eslint": "^8.57.0",
    "playwright": "1.64.0",
    "prettier": "^3.2.5",
    "prompts": "^2.4.2",
    "turbo": "^2.9.14"
  },
  "packageManager": "pnpm@9.15.4",
  "name": "healseek-frame"
}
