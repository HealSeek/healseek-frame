# Copy the checked-in environment files for local overrides:
#   .env, .env.development, .env.production
# Keep secrets out of VITE_* variables; these values are exposed to the browser.

# .env
VITE_APP_TITLE=HealSeek Frame Demo
# Keep this stable: it identifies existing browser sessions and preferences.
VITE_APP_NAMESPACE=airovo-playwright

# .env.development
VITE_PORT=5174
VITE_BASE=/
VITE_GLOB_API_URL=/api
VITE_NITRO_MOCK=true
VITE_DEVTOOLS=false
VITE_INJECT_APP_LOADING=true
VITE_ROUTER_HISTORY=web
